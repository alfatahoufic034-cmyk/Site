
# Server
PORT=5000

# JWT
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=1h

# CORS (comma separated origins)
CORS_ORIGIN=http://localhost:3000

# Supabase (optional)
SUPABASE_URL=
SUPABASE_KEY=

# SMTP (for emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Security alerts
SECURITY_ALERT_EMAIL=
SECURITY_WEBHOOK_URL=
RETENTION_SECURITY_ALERTS_DAYS=90

